# Cortex-M33 non-secure OpenAMP firmware for STM32MP257F-DK, loaded by Linux remoteproc.
# App sources live here; HAL, BSP, CMSIS, OpenAMP and libmetal come from STM32CubeMP2 (CUBE).
# Flags reproduce STM32CubeIDE configuration "CA35TDCID_m33_ns" of the
# OpenAMP_TTY_echo example (STM32CubeMP2 v1.3.2).
CUBE  ?= $(HOME)/st/stm32mp2/STM32CubeMP2-v1.3.2
APP   := $(CURDIR)
CLT   ?= /opt/st/stm32cubeclt_1.22.0
TC    ?= $(CLT)/GNU-tools-for-STM32/bin/arm-none-eabi-
CMAKE ?= $(CLT)/CMake/bin/cmake
CC    := $(TC)gcc
OBJCOPY := $(TC)objcopy
SIZE  := $(TC)size
OBJDUMP := $(TC)objdump
NAME  := m33_openamp
OUT   := out

HALS  := $(CUBE)/Drivers/STM32MP2xx_HAL_Driver/Src
OAMP  := $(CUBE)/Middlewares/Third_Party/OpenAMP
METAL := $(OAMP)/libmetal/lib
# libmetal headers are generated by its cmake (CubeIDE pre-build step)
METAL_INC := $(OUT)/libmetal/lib/include

C_SRCS := \
 $(CUBE)/Utilities/ResourcesManager/res_mgr.c \
 $(CUBE)/Drivers/CMSIS/Device/ST/STM32MP2xx/Source/Templates/system_stm32mp2xx_m33_ns.c \
 $(HALS)/stm32mp2xx_hal.c $(HALS)/stm32mp2xx_hal_cortex.c $(HALS)/stm32mp2xx_hal_dma.c \
 $(HALS)/stm32mp2xx_hal_dma_ex.c $(HALS)/stm32mp2xx_hal_exti.c $(HALS)/stm32mp2xx_hal_gpio.c \
 $(HALS)/stm32mp2xx_hal_icache.c $(HALS)/stm32mp2xx_hal_ipcc.c $(HALS)/stm32mp2xx_hal_pwr.c \
 $(HALS)/stm32mp2xx_hal_pwr_ex.c $(HALS)/stm32mp2xx_hal_rcc.c $(HALS)/stm32mp2xx_hal_rcc_ex.c \
 $(HALS)/stm32mp2xx_hal_uart.c $(HALS)/stm32mp2xx_hal_uart_ex.c $(HALS)/stm32mp2xx_hal_dcache.c \
 $(APP)/Core/Src/main.c $(APP)/Core/Src/stm32mp2xx_hal_msp.c $(APP)/Core/Src/stm32mp2xx_it.c \
 $(CUBE)/Utilities/Services/GenericServices/syscalls.c \
 $(APP)/OPENAMP/mbox_ipcc.c $(APP)/OPENAMP/openamp.c $(APP)/OPENAMP/openamp_log.c \
 $(APP)/OPENAMP/rsc_table.c \
 $(CUBE)/Drivers/BSP/STM32MP257F-DK/stm32mp257f_disco.c \
 $(METAL)/device.c $(METAL)/init.c $(METAL)/io.c $(METAL)/log.c $(METAL)/shmem.c \
 $(OAMP)/virtual_driver/virt_uart.c \
 $(METAL)/system/generic/condition.c $(METAL)/system/generic/generic_device.c \
 $(METAL)/system/generic/generic_init.c $(METAL)/system/generic/generic_io.c \
 $(METAL)/system/generic/generic_shmem.c $(METAL)/system/generic/time.c \
 $(METAL)/system/generic/template/sys.c \
 $(OAMP)/open-amp/lib/remoteproc/remoteproc_virtio.c $(OAMP)/open-amp/lib/rpmsg/rpmsg.c \
 $(OAMP)/open-amp/lib/rpmsg/rpmsg_virtio.c $(OAMP)/open-amp/lib/virtio/virtio.c \
 $(OAMP)/open-amp/lib/virtio/virtqueue.c \
 $(CUBE)/Utilities/CoproSync/copro_sync.c
S_SRCS := $(CUBE)/Drivers/CMSIS/Device/ST/STM32MP2xx/Source/Templates/gcc/startup_stm32mp257cxx_m33.s

LDSCRIPT := $(CUBE)/Drivers/CMSIS/Device/ST/STM32MP2xx/Source/Templates/gcc/linker/stm32mp2xx_DDR_m33_ns.ld

C_DEFS := -DSTM32MP257Cxx -DICACHE_DCACHE_USE -DSTM32MP25xxxx -DCORE_CM33 -DUSE_HAL_DRIVER \
 -DNO_ATOMIC_64_SUPPORT -DMETAL_INTERNAL -DVIRTIO_DEVICE_ONLY -DMETAL_MAX_DEVICE_REGIONS=2 \
 -DLINUX_RPROC_MASTER
AS_DEFS := -DSTM32MP257Cxx -DSTM32MP25xxxx

C_INCS := -I$(APP)/Core/Inc -I$(CUBE)/Utilities/ResourcesManager -I$(APP)/OPENAMP \
 -I$(OAMP)/open-amp/lib/include -I$(METAL_INC) -I$(OAMP)/virtual_driver \
 -I$(CUBE)/Drivers/CMSIS/Device/ST/STM32MP2xx/Include -I$(CUBE)/Drivers/CMSIS/Core/Include \
 -I$(CUBE)/Drivers/STM32MP2xx_HAL_Driver/Inc -I$(CUBE)/Drivers/BSP/STM32MP257F-DK \
 -I$(CUBE)/Utilities/CoproSync

FPU := -mcpu=cortex-m33 --specs=nano.specs -mfpu=fpv5-sp-d16 -mfloat-abi=hard -mthumb
CFLAGS := $(FPU) -std=gnu11 -g3 $(C_DEFS) $(C_INCS) -Os -ffunction-sections -fdata-sections \
 -Wall -fstack-usage -MMD -MP
ASFLAGS := $(FPU) -g3 $(AS_DEFS) -x assembler-with-cpp -MMD -MP
LDFLAGS := $(FPU) -T$(LDSCRIPT) --specs=nosys.specs -Wl,-Map=$(OUT)/$(NAME).map \
 -Wl,--gc-sections -static -z max-page-size=4096 -Wl,--start-group -lc -lm -Wl,--end-group

OBJS := $(addprefix $(OUT)/obj/,$(notdir $(C_SRCS:.c=.o))) $(addprefix $(OUT)/obj/,$(notdir $(S_SRCS:.s=.o)))
vpath %.c $(sort $(dir $(C_SRCS)))
vpath %.s $(sort $(dir $(S_SRCS)))

all: $(OUT)/$(NAME).elf $(OUT)/$(NAME)_stripped.elf $(OUT)/$(NAME).list

# The cmake step also copies the generic_*.c files into the CUBE libmetal tree.
$(METAL_INC)/metal/config.h:
	PATH=$(dir $(TC)):$$PATH $(CMAKE) -S $(OAMP)/libmetal -B $(OUT)/libmetal -G"Unix Makefiles" \
	 -DCMAKE_TOOLCHAIN_FILE=cmake/platforms/stm32mp-generic-gcc.cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5

$(OUT)/obj/%.o: %.c $(METAL_INC)/metal/config.h | $(OUT)/obj
	$(CC) $< $(CFLAGS) -c -o $@
$(OUT)/obj/%.o: %.s | $(OUT)/obj
	$(CC) $(ASFLAGS) -c -o $@ $<
$(OUT)/obj:
	mkdir -p $@

$(OUT)/$(NAME).elf: $(OBJS) $(LDSCRIPT)
	$(CC) -o $@ $(OBJS) $(LDFLAGS)
	$(SIZE) $@

$(OUT)/$(NAME)_stripped.elf: $(OUT)/$(NAME).elf
	$(OBJCOPY) -S $< $@
$(OUT)/$(NAME).list: $(OUT)/$(NAME).elf
	$(OBJDUMP) -h -S $< > $@

clean:
	rm -rf $(OUT)
-include $(OBJS:.o=.d)
.PHONY: all clean
